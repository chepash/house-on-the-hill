---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { langs, t, type Lang } from '../../../i18n/ui';
import { books, getBookItems, type Book, type BookItem } from '../../../lib/haunts';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of langs) {
    for (const book of books) {
      for (const item of await getBookItems(book, lang)) {
        paths.push({ params: { lang, book, haunt: item.slug }, props: { item } });
      }
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const book = Astro.params.book as Book;
const { item } = Astro.props as { item: BookItem };
const { number, slug, note, info, elsewhere } = item;
const { Content } = await render(note);
---

<Base lang={lang} book={book} title={`${number} · ${info.title}`}>
  <p class="eyebrow">
    <a href={getRelativeLocaleUrl(lang, `${book}/`)}>{t(lang, `book.${book}.title`)}</a>
  </p>
  <h1><span class="haunt-number">{number}</span> {info.title}</h1>
  {info.titleEn && <p class="subtitle" lang="en">{info.titleEn}</p>}

  {
    elsewhere ? (
      // Not the book's pointer note: it names the whole group of haunts ("2–8 have no
      // traitor..."), which is a hint for anyone who opens one of them.
      <p class="prose">{t(lang, 'haunt.elsewhere')}</p>
    ) : (
      <article class="prose">
        <Content />
      </article>
    )
  }

  {
    elsewhere && (
      <a class="choice" data-book={elsewhere} href={getRelativeLocaleUrl(lang, `${elsewhere}/${slug}/`)}>
        <span class="choice__text">
          <span class="choice__side">{t(lang, `book.${elsewhere}.title`)}</span>
          <span class="choice__title">
            {number} · {info.title} →
          </span>
        </span>
      </a>
    )
  }

  <nav class="page-footer">
    <a href={getRelativeLocaleUrl(lang, `${book}/`)}>← {t(lang, 'haunt.back')}</a>
  </nav>
</Base>
