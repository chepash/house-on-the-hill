---
import { getRelativeLocaleUrl } from 'astro:i18n';
import HauntJump from '../../../components/HauntJump';
import Base from '../../../layouts/Base.astro';
import { langs, t, type Lang } from '../../../i18n/ui';
import { books, getBookItems, type Book } from '../../../lib/haunts';

export function getStaticPaths() {
  return langs.flatMap((lang) => books.map((book) => ({ params: { lang, book } })));
}

const lang = Astro.params.lang as Lang;
const book = Astro.params.book as Book;
const items = await getBookItems(book, lang);
const url = (slug: string) => getRelativeLocaleUrl(lang, `${book}/${slug}/`);
const jumpTargets = Object.fromEntries(items.map((item) => [item.number, url(item.slug)]));
---

<Base lang={lang} book={book} title={t(lang, `book.${book}.title`)}>
  <p class="eyebrow">{t(lang, `book.${book}.side`)}</p>
  <h1>{t(lang, `book.${book}.title`)}</h1>
  <p class="warning">{t(lang, `book.${book}.warning`)}</p>

  <HauntJump
    client:load
    targets={jumpTargets}
    labels={{
      label: t(lang, 'list.jump.label'),
      submit: t(lang, 'list.jump.submit'),
      notFound: t(lang, 'list.jump.notFound'),
    }}
  />

  <ol class="haunt-list">
    {
      items.map(({ number, slug, info }) => (
        <li>
          <a class="haunt-row" href={url(slug)}>
            <span class="haunt-row__number">{number}</span>
            <span class="haunt-row__text">
              <span class="haunt-row__title">{info.title}</span>
              {info.trigger && (
                <span class="haunt-row__meta">
                  {info.trigger} · {info.traitor}
                </span>
              )}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</Base>
