---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Base from '../../layouts/Base.astro';
import { langs, t, type Lang } from '../../i18n/ui';
import { withBase } from '../../i18n/paths';
import { books } from '../../lib/haunts';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

const bookIcons = {
  'secrets-of-survival': 'icons/hero.png',
  'traitors-tome': 'icons/death.svg',
} as const;
---

<Base lang={lang}>
  <h1>{t(lang, 'game.title')}</h1>

  <h2 id="side" data-anchor>{t(lang, 'home.side.title')}</h2>

  <ul class="choice-list">
    {
      books.map((book) => (
        <li>
          <a class="choice choice--book" data-book={book} href={getRelativeLocaleUrl(lang, `${book}/`)}>
            <img class="choice__icon" src={withBase(bookIcons[book])} alt="" width="56" height="56" />
            <span class="choice__text">
              <span class="choice__title">{t(lang, `book.${book}.title`)}</span>
              <span class="choice__body">{t(lang, `book.${book}.body`)}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <a class="choice choice--minor" href={getRelativeLocaleUrl(lang, 'terms/')}>
    <span class="choice__text">
      <span class="choice__title">{t(lang, 'terms.title')}</span>
    </span>
  </a>
</Base>
