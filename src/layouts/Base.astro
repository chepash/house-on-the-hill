---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ClientRouter } from 'astro:transitions';
import LanguageSwitch from '../components/LanguageSwitch';
import { localizedUrls, withBase } from '../i18n/paths';
import { t, type Lang } from '../i18n/ui';
import type { Book } from '../lib/haunts';
import { UNLOCK_AT } from '../scripts/lock';
import '../styles/global.css';

type Props = {
  lang: Lang;
  title?: string;
  /** Colors the page by side, so players see at a glance whose book is open. */
  book?: Book;
};

const { lang, title, book } = Astro.props;
const siteTitle = t(lang, 'site.title');
const urls = localizedUrls(Astro.url.pathname);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t(lang, 'site.description')} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="icon" href={withBase('favicon.ico')} />
    {Object.entries(urls).map(([l, url]) => <link rel="alternate" hreflang={l} href={url} />)}
    <title>{title ? `${title} · ${siteTitle}` : siteTitle}</title>
    <script is:inline define:vars={{ unlockAt: UNLOCK_AT, home: getRelativeLocaleUrl(lang), isBook: Boolean(book) }}>
      // Runs before the first paint: book pages leave at once, the home page gets its tape.
      // The same rules are re-applied after client-side navigation (scripts/lock.ts).
      if (Date.now() < unlockAt) {
        if (isBook) location.replace(home);
        else document.documentElement.classList.add('locked');
      }
    </script>
    <ClientRouter />
  </head>
  <body data-book={book} data-home={getRelativeLocaleUrl(lang)}>
    <header class="site-header">
      <a class="site-header__title" href={getRelativeLocaleUrl(lang)}>{siteTitle}</a>
      <LanguageSwitch client:load current={lang} urls={urls} label={t(lang, 'lang.label')} />
    </header>
    <main class="page">
      <slot />
    </main>
  </body>
</html>

<script>
  import { initCharacterRows } from '../scripts/characters-in-play';
  import { applyLock } from '../scripts/lock';
  import { rememberLang, restoreReadingAnchor } from '../scripts/reading-position';

  // The router has already scrolled the new page when after-swap fires,
  // so the saved position is applied before the new page is painted.
  document.addEventListener('astro:after-swap', restoreReadingAnchor);
  // The swap replaces <html> attributes, so the lock class is re-applied before paint.
  document.addEventListener('astro:after-swap', applyLock);
  document.addEventListener('astro:page-load', () => {
    applyLock();
    initCharacterRows();
    rememberLang(document.documentElement.lang);
  });
</script>
